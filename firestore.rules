rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function staffDoc() { return /databases/$(database)/documents/shops/main/staff/$(request.auth.uid); }
    function isStaff() { return request.auth != null && exists(staffDoc()); }
    function isAdmin() { return isStaff() && get(staffDoc()).data.role == "admin"; }

    // One staff document per person, created by hand in the console: { role: "admin" | "attendant", name: "..." }
    match /shops/main/staff/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow write: if false;
    }
    // Buying costs, restock prices and expenses: administrators only.
    match /shops/main/costs/{id}    { allow read, write: if isAdmin(); }
    match /shops/main/expenses/{id} { allow read, write: if isAdmin(); }
    match /shops/main/products/{id} { allow read: if isStaff(); allow write: if isAdmin(); }
    match /shops/main/bikes/{id} {
      allow read: if isStaff();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (isStaff() && resource.data.status == "Available"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "soldDate", "saleId"]));
    }
    match /shops/main/entries/{id} {
      allow read: if isStaff();
      allow create: if isAdmin() || (isStaff() && request.resource.data.type == "Sale");
      allow update, delete: if isAdmin();
    }
  }
}
